DB_User=postgres
DB_Password=
DB_host=localhost
DB_Name=verifik
PORT=3001
JWT_SECRET=replace_with_a_long_random_secret
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
LOCAL_FRONTEND_URL=http://localhost:5173
NODE_ENV=development
DB_SYNC_FORCE=false
# Las semillas son exclusivamente locales y el backend las rechaza en producción.
SEED_DEMO_DATA=false

# Tusdatos: usa HTTPS obligatoriamente en producción. Nunca subas este archivo
# con credenciales reales; guárdalas solo en .env o en tu proveedor de secretos.
TUSDATOS_BASE_URL=https://dash-board.tusdatos.co
TUSDATOS_AUTH_MODE=bearer
TUSDATOS_USERNAME=
TUSDATOS_PASSWORD=
TUSDATOS_API_TOKEN=
TUSDATOS_WEBHOOK_TOKEN=
TUSDATOS_REQUEST_TIMEOUT_MS=15000
TUSDATOS_MIN_LAUNCH_INTERVAL_MS=5000
TUSDATOS_POLL_INITIAL_DELAY_MS=60000
TUSDATOS_POLL_INTERVAL_MS=5000
TUSDATOS_POLL_MAX_INTERVAL_MS=30000
TUSDATOS_MAX_POLL_ATTEMPTS=240
TUSDATOS_MONITOR_LEASE_MS=60000
TUSDATOS_JOB_TIMEOUT_MS=6900000
TUSDATOS_LAUNCH_RECOVERY_TIMEOUT_MS=120000
TUSDATOS_LONG_WAIT_MS=180000
TUSDATOS_QUERY_MONITOR_ENABLED=true

# Evita cobros dobles por doble clic o reintentos inmediatos del navegador.
QUERY_IDEMPOTENCY_WINDOW_MS=60000

# Wompi: usa únicamente credenciales sandbox en desarrollo.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
